// ============================================================================
//   Tripz Backend — Database Schema (DBML format)
//
//   HOW TO VIEW:
//     1. Copy the ENTIRE contents of this file
//     2. Open https://dbdiagram.io/d (free, no signup needed)
//     3. Paste in the left panel — diagram appears on the right
//
//   ALTERNATIVE FREE TOOLS:
//     • https://drawdb.vercel.app  (open-source, supports DBML import)
//     • https://dbdocs.io           (CLI: install dbdocs, run dbdocs build)
//     • VS Code "DBML" extension    (preview locally)
//
//   This file mirrors the Prisma schema at prisma/schema/*.prisma.
// ============================================================================

Project tripz {
  database_type: 'PostgreSQL'
  Note: 'Tripz — multi-panel travel platform (SuperAdmin / Admin / Vendor / Customer)'
}

// ---------------------------------------------------------------------------
//   ENUMS
// ---------------------------------------------------------------------------

Enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CLIENT
}

Enum AuthProvider {
  LOCAL    [note: 'Email + password only']
  GOOGLE   [note: 'Google OAuth only — no password']
  HYBRID   [note: 'Both methods linked to one account']
}

Enum EmailOtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_2FA
  AADHAAR_VERIFICATION
}

Enum KycStatus {
  PENDING    [note: 'Vendor signed up; KYC not submitted yet']
  SUBMITTED  [note: 'Awaiting admin review']
  APPROVED   [note: 'Vendor can take work']
  REJECTED   [note: 'Vendor must resubmit with fixes']
}

Enum CompanyType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PVT_LTD
  PUBLIC_LTD
  OTHER
}

Enum ReferralSource {
  REFERENCE
  GOOGLE
  SOCIAL_MEDIA
  ADVERTISEMENT
  OTHER
}

Enum KycDocumentType {
  PAN
  GSTIN
  CIN
  AADHAR
  OTHER
}

Enum LeadStatus {
  PENDING_REVIEW [note: 'Customer just submitted; awaiting admin approval']
  ACTIVE         [note: 'Admin approved; live on the marketplace feed']
  EXHAUSTED      [note: 'Hit maxUnlocks — no more vendors can buy']
  EXPIRED        [note: 'Past travelDate / TTL window — auto-closed by cron']
  REJECTED       [note: 'Admin rejected (spam, duplicate, bad data)']
  CLOSED         [note: 'Customer or admin manually closed']
}

Enum WalletTransactionType {
  DEBIT_LEAD_UNLOCK          [note: 'Vendor spent credits to unlock a lead']
  CREDIT_TOP_UP              [note: 'From payment gateway (Razorpay — future)']
  CREDIT_REFUND              [note: 'Refund for a disputed unlock']
  CREDIT_ADMIN_ADJUSTMENT    [note: 'Admin granted credits manually']
  DEBIT_ADMIN_ADJUSTMENT     [note: 'Admin clawed credits back']
  CREDIT_SUBSCRIPTION_GRANT  [note: 'Credits granted on subscription plan purchase']
}

Enum SubscriptionStatus {
  ACTIVE     [note: 'Currently valid and running']
  EXPIRED    [note: 'Past expiresAt — no longer valid']
  CANCELLED  [note: 'Admin or vendor cancelled before expiry']
  UPGRADED   [note: 'Vendor moved to a higher plan; superseded by replacedBySubscriptionId']
}

Enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

Enum PackageStatus {
  DRAFT     [note: 'Vendor is still editing; not visible to customers or admin queue']
  SUBMITTED [note: 'Sent for admin review']
  APPROVED  [note: 'Live on marketplace — customers can inquire']
  REJECTED  [note: 'Admin rejected with a reason; vendor can edit + resubmit']
  PAUSED    [note: 'Vendor self-paused (off-season) or auto-paused when subscription expires']
}

Enum PackageType {
  FAMILY
  COUPLE
  HONEYMOON
  SOLO
  GROUP          [note: 'Friends / group trip (e.g., "trip-travelers")']
  ADVENTURE      [note: 'Trekking, water sports, etc.']
  RELIGIOUS      [note: 'Pilgrimage tours']
  BEACH
  HILL_STATION
  WILDLIFE       [note: 'Safaris, national parks']
  CULTURAL       [note: 'Heritage, temples, cultural tours']
  CORPORATE      [note: 'Team offsites, business trips']
  OTHER
}

Enum PackageValidityType {
  EVERGREEN [note: 'Always available — startDate/endDate optional/null']
  SEASONAL  [note: 'Time-boxed (festival, event) — startDate + endDate REQUIRED']
}

// ---------------------------------------------------------------------------
//   TABLES — Identity + Auth
// ---------------------------------------------------------------------------

Table users {
  id              varchar      [pk, note: 'App-generated: <PREFIX>-<6-digit random> e.g. VEND-273728, CLIENT-003434']
  firstName       varchar      [not null]
  lastName        varchar      [not null]
  email           varchar      [unique, not null]
  phone           varchar      [unique, note: 'Nullable for Google signups']
  password        varchar      [note: 'Nullable for Google-only users']
  googleId        varchar      [unique, note: 'Google OAuth sub claim']
  avatarUrl       varchar      [note: 'Profile picture URL']
  authProvider    AuthProvider [not null, default: 'LOCAL']
  role            UserRole     [not null, default: 'CLIENT']
  isActive        boolean      [not null, default: `true`]
  emailVerifiedAt timestamp    [note: 'Null until /auth/verify-email succeeds']
  createdAt       timestamp    [not null]
  updatedAt       timestamp    [not null]

  indexes {
    role
  }

  Note: 'Single human-identity table. Customer-specific and vendor-specific data live in *_profiles.'
}

Table refresh_tokens {
  id        varchar   [pk]
  token     varchar   [unique, not null, note: 'SHA-256 hash, never plaintext']
  userId    varchar   [not null, ref: > users.id]
  isRevoked boolean   [not null, default: `false`]
  expiresAt timestamp [not null]
  createdAt timestamp [not null]

  indexes {
    userId
    expiresAt
  }

  Note: 'One row per active session. Rotation on each /auth/refresh.'
}

Table email_otps {
  id         varchar         [pk]
  userId     varchar         [not null, ref: > users.id]
  codeHash   varchar         [not null, note: 'SHA-256 of OTP, or sentinel for provider-managed (Aadhaar live mode)']
  purpose    EmailOtpPurpose [not null]
  expiresAt  timestamp       [not null]
  consumedAt timestamp       [note: 'Set when OTP is successfully used or burned']
  attempts   int             [not null, default: 0]
  createdAt  timestamp       [not null]

  indexes {
    (userId, purpose)
    expiresAt
  }

  Note: 'Stores OTP sessions for email verification, password reset, and Aadhaar OTP rate limiting.'
}

// ---------------------------------------------------------------------------
//   TABLES — Role Profiles
// ---------------------------------------------------------------------------

Table vendor_profiles {
  userId    varchar   [pk, ref: - users.id, note: 'PK doubles as FK to users.id']
  kycStatus KycStatus [not null, default: 'PENDING']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  indexes {
    kycStatus
  }

  Note: 'Exists only when User.role = VENDOR. Created at signup.'
}

Table customer_profiles {
  userId    varchar   [pk, ref: - users.id, note: 'PK doubles as FK to users.id']
  createdAt timestamp [not null]
  updatedAt timestamp [not null]

  Note: 'Exists only when User.role = CLIENT. Placeholder for future customer-only fields.'
}

// ---------------------------------------------------------------------------
//   TABLES — Vendor KYC
// ---------------------------------------------------------------------------

Table vendor_kyc {
  vendorUserId         varchar        [pk, ref: - vendor_profiles.userId]

  // -- Company identity
  companyName          varchar        [not null]
  businessName         varchar        [note: 'Optional DBA / trading name']
  companyType          CompanyType
  companySinceYears    int            [note: 'Years in business']
  teamSize             int
  companyLogoUrl       varchar        [note: 'Cloudinary URL']

  // -- Location
  country              varchar        [not null]
  officeAddress        varchar        [not null]
  officeCity           varchar
  officeState          varchar

  // -- Business operations
  services             "varchar[]"    [note: 'Postgres text array (e.g., TRAVEL LEADS)']
  destinations         "varchar[]"    [note: 'Postgres text array (e.g., Andhra Pradesh, Assam)']
  dailyLeadRequirement int

  // -- Online presence
  websiteUrl           varchar
  facebookUrl          varchar
  instagramUrl         varchar

  // -- Referral
  referralSource       ReferralSource
  otherSource          varchar        [note: 'Filled when referralSource = OTHER']
  marketplaceWorked    boolean        [not null, default: `false`]

  // -- Legal declaration
  agreedTerms          boolean        [not null, default: `false`]
  declaredTrue         boolean        [not null, default: `false`]

  // -- Admin workflow
  submittedAt          timestamp      [not null]
  reviewedAt           timestamp
  reviewedByAdminId    varchar        [note: 'User.id of the admin who reviewed']
  rejectionReason      text

  Note: 'Company-level fields submitted in the wizard. Documents live in vendor_kyc_documents.'
}

Table vendor_kyc_documents {
  id                   varchar         [pk]
  vendorUserId         varchar         [not null, ref: > vendor_profiles.userId]
  type                 KycDocumentType [not null]
  documentNumber       varchar         [note: 'PAN string, GST number, etc.']
  documentUrl          varchar         [note: 'Cloudinary URL — used for OTHER docs (address proof, bank proof, etc.)']

  // -- Admin manual review
  isVerified           boolean         [not null, default: `false`]
  verifiedAt           timestamp
  verifiedByAdminId    varchar
  notes                text

  // -- Third-party (automated, via provider — Surepass / stub)
  thirdPartyVerified   boolean         [not null, default: `false`]
  thirdPartyProvider   varchar         [note: 'STUB or SUREPASS']
  thirdPartyVerifiedAt timestamp
  thirdPartyResponse   json            [note: 'Raw provider response for audit']

  createdAt            timestamp       [not null]
  updatedAt            timestamp       [not null]

  indexes {
    (vendorUserId, type) [unique, note: 'One row per doc type per vendor']
  }

  Note: 'Verified by /vendor/kyc/verify/* endpoints. Persists independently of vendor_kyc submissions.'
}

// ---------------------------------------------------------------------------
//   TABLES — Leads Marketplace
// ---------------------------------------------------------------------------

Table leads {
  id             varchar    [pk]

  // -- Hot indexed fields
  destination    varchar    [not null, note: 'Wizard form.destination']
  departureCity  varchar    [note: 'Promoted from JSONB; vendors filter by hub']
  travelDate     timestamp  [note: 'Promoted from JSONB; date-range + expiry cron']
  email          varchar    [not null, note: 'Masked in teaser mode']
  phone          varchar    [not null, note: 'Masked in teaser mode']
  budget         int        [note: 'INR amount; null when not provided']
  customerUserId varchar    [ref: > users.id, note: 'Null for anonymous submissions; SetNull on user delete']

  // -- Routing (Phase 2: dual-lead)
  targetVendorId varchar    [ref: > users.id, note: 'null = global lead (marketplace); set = direct lead (this vendor only, maxUnlocks=1)']
  packageId      varchar    [ref: > packages.id, note: 'Non-null when the lead came from a package inquiry page. Auto-derives targetVendorId + destination + directLeadPriceCredits from the package']

  // -- Dynamic form payload (JSONB)
  requirements   json       [not null, note: 'duration, hotelCategory, flightRequired, adults, infants, children, tourType, etc.']

  // -- Marketplace mechanics
  status         LeadStatus [not null, default: 'PENDING_REVIEW']
  priceInCredits int        [not null, default: 10, note: 'Cost a vendor pays to unlock']
  maxUnlocks     int        [not null, default: 3, note: 'Cap on vendors who can buy']
  unlockCount    int        [not null, default: 0, note: 'Monotonically increasing counter']

  // -- Admin workflow
  reviewedAt        timestamp
  reviewedByAdminId varchar
  rejectionReason   text

  createdAt      timestamp  [not null]
  updatedAt      timestamp  [not null]

  indexes {
    status
    destination
    departureCity
    travelDate
    createdAt
    email
    (targetVendorId, status) [note: 'Fast "my direct leads" lookup for vendors']
    packageId                [note: 'Fast "all leads for this package" lookup']
  }

  Note: 'Travel inquiry submitted by a customer. Hybrid storage — hot fields as columns, form payload in JSONB.'
}

Table lead_assignments {
  id                  varchar   [pk]
  leadId              varchar   [not null, ref: > leads.id, note: 'Cascade on lead delete']
  vendorUserId        varchar   [not null, ref: > vendor_profiles.userId, note: 'Cascade on vendor delete']
  priceInCreditsPaid  int       [not null, note: 'Snapshot of price at unlock time']
  walletTransactionId varchar   [unique, not null, ref: > wallet_transactions.id, note: '1:1 with the DEBIT ledger row']
  unlockedAt          timestamp [not null]

  indexes {
    (leadId, vendorUserId) [unique, note: 'A vendor can unlock each lead only once']
    vendorUserId
    leadId
  }

  Note: 'Source of truth for "can this vendor see the real phone/email?". Created atomically alongside the wallet debit ledger row.'
}

// ---------------------------------------------------------------------------
//   TABLES — Wallet + Ledger
// ---------------------------------------------------------------------------

Table wallets {
  vendorUserId   varchar   [pk, ref: - vendor_profiles.userId, note: 'Cascade on vendor delete']
  balanceCredits int       [not null, default: 0]
  createdAt      timestamp [not null]
  updatedAt      timestamp [not null]

  Note: 'One wallet per vendor. Created lazily on first credit operation. Balance in abstract "credits" — INR conversion lives in the payments turn.'
}

Table wallet_transactions {
  id            varchar               [pk]
  vendorUserId  varchar               [not null, ref: > wallets.vendorUserId, note: 'Cascade on wallet delete']
  type          WalletTransactionType [not null]
  amount        int                   [not null, note: 'Always >= 0; sign implied by type']
  balanceAfter  int                   [not null, note: 'Post-application snapshot for audit']
  referenceType varchar               [note: '"LEAD_ASSIGNMENT" / "PAYMENT" / "ADMIN" / "SUBSCRIPTION"']
  referenceId   varchar               [note: 'FK-ish pointer to the row that caused this ledger entry']
  notes         text
  createdAt     timestamp             [not null]

  indexes {
    (vendorUserId, createdAt)
    type
  }

  Note: 'Append-only ledger. Every wallet balance change writes exactly one row here.'
}

// ---------------------------------------------------------------------------
//   TABLES — Subscription Plans + Vendor Subscriptions
// ---------------------------------------------------------------------------

Table subscription_plans {
  id              varchar      [pk]

  // -- Core identity
  name            varchar      [not null, note: '"Basic Brown Plan", "Advance Silver", …']
  slug            varchar      [unique, not null, note: 'URL-friendly, auto-generated from name']
  description     varchar      [not null, note: 'Pitch line shown under name on the pricing card']

  // -- Pricing (INR × 100 — matches Razorpay amount format)
  salePriceInPaise    int      [not null, note: 'MRP (shown crossed out)']
  offerPriceInPaise   int      [not null, note: 'Actual price the vendor pays; used in the Add-Days upgrade formula']
  billingCycle        BillingCycle [not null, default: 'MONTHLY']
  durationDays        int      [not null, note: '30 for monthly, 90 for quarterly, etc.']
  trialDays           int      [not null, default: 0]

  // -- Backend business logic
  includedCredits         int  [not null, default: 0, note: 'Credits granted to wallet on purchase']
  maxPackages             int  [not null, note: '-1 = unlimited (enforced in Phase 2)']
  directLeadPriceCredits  int  [not null, default: 5, note: 'Phase 2: cost of a package-inquiry direct lead']
  priorityWeight          int  [not null, default: 0, note: 'Higher = better marketplace ranking']

  // -- Display flags (queryable/sortable)
  isFeatured      boolean      [not null, default: `false`, note: '"Most Popular" ribbon plan']
  displayOrder    int          [not null, default: 0, note: 'Sort order on the pricing page (1, 2, 3…)']
  isActive        boolean      [not null, default: `true`, note: 'False = hidden from vendor catalog; existing subs keep running']
  deletedAt       timestamp    [note: 'Soft-delete marker. Non-null = permanently retired (irreversible)']

  // -- Frontend content (iterate freely, no migrations)
  displayContent  json         [not null, note: 'Pricing-card content: badgeText, ribbonText, iconUrl, themeColor, ctaButtonText, features[]']
  rules           json         [not null, note: 'Future edge-case rules escape hatch']

  createdAt       timestamp    [not null]
  updatedAt       timestamp    [not null]

  indexes {
    (isActive, isFeatured)
    deletedAt
    displayOrder
  }

  Note: 'Admin-managed subscription plan catalog. Hybrid storage: business fields as columns (queryable), marketing/display content in displayContent JSONB (iterate without migrations).'
}

Table vendor_subscriptions {
  id                       varchar            [pk]
  vendorUserId             varchar            [not null, ref: > vendor_profiles.userId, note: 'Cascade on vendor delete']
  planId                   varchar            [not null, ref: > subscription_plans.id]
  status                   SubscriptionStatus [not null, default: 'ACTIVE']

  startsAt                 timestamp          [not null]
  expiresAt                timestamp          [not null, note: 'startsAt + plan.durationDays (+ bonusDays for upgrades)']
  cancelledAt              timestamp
  cancelledBy              varchar            [note: 'Admin userId if force-cancelled']

  // -- Upgrade lineage
  replacedBySubscriptionId varchar            [unique, note: 'If this is the "old" side of an upgrade, points at the new sub row']

  // -- Purchase-time snapshots (so plan-price edits later dont rewrite history)
  creditsGranted           int                [not null, default: 0, note: 'plan.includedCredits at purchase time']
  bonusDays                int                [not null, default: 0, note: 'Extra days from Add-Days upgrade formula; 0 for fresh purchases']

  // -- Razorpay linkage (populated in payments phase)
  paymentRef               varchar            [note: 'Razorpay order/payment id — nullable in the Phase-1 direct-buy MVP']

  createdAt                timestamp          [not null]
  updatedAt                timestamp          [not null]

  indexes {
    (vendorUserId, status)
    expiresAt
    planId
  }

  Note: 'Vendor purchase instance for a plan. One ACTIVE row per vendor at a time (service-layer enforced). UPGRADED rows form an audit chain via replacedBySubscriptionId.'
}

// ---------------------------------------------------------------------------
//   TABLES — Packages (vendor-created marketplace offerings)
// ---------------------------------------------------------------------------

Table packages {
  id                 varchar             [pk]
  vendorUserId       varchar             [not null, note: 'Owner — set from JWT, not from client payload']
  slug               varchar             [unique, not null, note: 'URL-friendly, auto-generated from title + vendor prefix']

  // -- Content
  title              varchar             [not null, note: 'e.g., "Kashmir 4N/2D Family Package"']
  agencyName         varchar             [note: 'Displayed as "Package by <agency>"; nullable — individual vendors leave it blank']
  destination        varchar             [not null, note: 'e.g., "Kashmir", "Goa" — indexed for filter']
  route              varchar             [note: 'Descriptive route text, e.g., "2N and 2D"']
  duration           varchar             [note: 'Descriptive duration, e.g., "4N/2D"']
  overview           text                [note: 'Long marketing copy']
  otherDetails       text
  cancellationPolicy text                [note: 'Rich text — HTML allowed']

  // -- Categorization
  packageType        PackageType         [not null]
  validityType       PackageValidityType [not null, default: 'EVERGREEN']

  // -- Availability window (REQUIRED when validityType = SEASONAL)
  startDate          timestamp           [note: 'Package available from this date']
  endDate            timestamp           [note: 'Package available until this date']

  // -- Pricing (INR × 100 — matches SubscriptionPlan convention)
  priceInPaise       int                 [not null, note: 'Offer price the customer sees']
  oldPriceInPaise    int                 [note: 'MRP shown crossed out — nullable if no discount shown']
  discountPercent    int                 [note: 'For explicit "10% off" badge; nullable']

  // -- Amenities (free-form strings, admin-approved)
  hotelCategory      varchar             [note: 'e.g., "3 star", "4 star", "5 star"']
  transfers          varchar             [note: 'e.g., "cab", "flight+cab"']
  meals              varchar             [note: 'e.g., "breakfast included", "all meals"']
  sightseeing        varchar

  // -- Media
  mainImageUrl       varchar             [not null, note: 'Cover image URL (Cloudinary)']
  galleryImageUrls   "varchar[]"         [note: 'Additional gallery images']

  // -- Structured lists
  highlights         "varchar[]"         [note: 'Bullet items: "wifi", "phone", etc.']
  inclusions         "varchar[]"
  exclusions         "varchar[]"
  itinerary          json                [note: 'Array of {day, title, text}']

  // -- Offer highlight
  offerTitle         varchar             [note: 'e.g., "wifi", "free upgrade"']
  offerDescription   text

  // -- Lifecycle
  status             PackageStatus       [not null, default: 'DRAFT']
  hasPendingReview   boolean             [not null, default: `false`, note: 'True when APPROVED package has been edited but not re-approved']

  // -- Admin workflow
  submittedAt        timestamp           [note: 'When vendor moved to SUBMITTED']
  reviewedAt         timestamp           [note: 'When admin approved/rejected']
  reviewedByAdminId  varchar             [note: 'Admin user id']
  rejectionReason    text                [note: 'Admin note when REJECTED']

  createdAt          timestamp           [not null]
  updatedAt          timestamp           [not null]

  indexes {
    (status, validityType)
    destination
    packageType
    (vendorUserId, status)
    (validityType, endDate)  [note: 'Fast query for expiring SEASONAL packages']
  }

  Note: 'Vendor-created travel packages. Two visibility gates: (1) subscription must be active + within maxPackages, (2) admin approval. SEASONAL packages auto-hide when endDate passes.'
}

// ---------------------------------------------------------------------------
//   RELATIONSHIPS (explicit — same as the `ref:` annotations above,
//   listed here for tools that prefer central declarations)
// ---------------------------------------------------------------------------

// Auth
Ref: refresh_tokens.userId                > users.id                    [delete: cascade]
Ref: email_otps.userId                    > users.id                    [delete: cascade]

// Profiles (1:1 with users)
Ref: vendor_profiles.userId               - users.id                    [delete: cascade]
Ref: customer_profiles.userId             - users.id                    [delete: cascade]

// KYC
Ref: vendor_kyc.vendorUserId              - vendor_profiles.userId      [delete: cascade]
Ref: vendor_kyc_documents.vendorUserId    > vendor_profiles.userId      [delete: cascade]

// Leads
Ref: leads.customerUserId                 > users.id                    [delete: set null]
Ref: leads.targetVendorId                 > users.id                    [delete: set null]
Ref: leads.packageId                      > packages.id                 [delete: set null]

// Lead assignments (unlock events)
Ref: lead_assignments.leadId              > leads.id                    [delete: cascade]
Ref: lead_assignments.vendorUserId        > vendor_profiles.userId      [delete: cascade]
Ref: lead_assignments.walletTransactionId > wallet_transactions.id

// Wallet ledger
Ref: wallets.vendorUserId                 - vendor_profiles.userId      [delete: cascade]
Ref: wallet_transactions.vendorUserId     > wallets.vendorUserId        [delete: cascade]

// Subscriptions
Ref: vendor_subscriptions.vendorUserId    > vendor_profiles.userId      [delete: cascade]
Ref: vendor_subscriptions.planId          > subscription_plans.id

// Packages
Ref: packages.vendorUserId                > vendor_profiles.userId      [delete: cascade]

// ---------------------------------------------------------------------------
//   TABLE GROUPS (visual grouping in dbdiagram.io)
// ---------------------------------------------------------------------------

TableGroup auth {
  users
  refresh_tokens
  email_otps
}

TableGroup profiles {
  vendor_profiles
  customer_profiles
}

TableGroup kyc {
  vendor_kyc
  vendor_kyc_documents
}

TableGroup leads_marketplace {
  leads
  lead_assignments
}

TableGroup wallet {
  wallets
  wallet_transactions
}

TableGroup subscriptions {
  subscription_plans
  vendor_subscriptions
}

TableGroup packages {
  packages
}
