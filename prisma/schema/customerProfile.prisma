// CustomerProfile is intentionally minimal today. Role-specific customer fields
// (preferences, loyalty, default currency, etc.) will land here so the User
// table stays clean.
model CustomerProfile {
  userId    String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}
