model BusinessProfile {
  id            String   @id @default(uuid())
  sourceKey     String   @unique
  keyword       String?
  location      String
  companyName   String
  category      String?
  website       String?
  phone         String?
  emails        String[]
  address       String?  @db.Text
  city          String?
  state         String?
  pincode       String?
  rating        Float?
  reviewCount   Int?
  googleMapsUrl String?
  isActive      Boolean  @default(true)

  importedByAdminId String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive, companyName])
  @@index([location])
  @@index([city])
  @@index([state])
  @@index([category])
  @@index([rating])
  @@index([deletedAt])
  @@map("business_profiles")
}
