model User {
  id              String       @id
  // ↑ Generated by app code (not UUID) — see src/utils/userId.js.
  // Format: <PREFIX>-<6-digit zero-padded random> e.g. VEND-273728, CLIENT-003434.
  firstName       String
  lastName        String
  email           String       @unique
  phone           String?      @unique
  password        String?
  googleId        String?      @unique
  avatarUrl       String?
  authProvider    AuthProvider @default(LOCAL)
  role            UserRole     @default(CLIENT)
  isActive        Boolean      @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  refreshTokens   RefreshToken[]
  emailOtps       EmailOtp[]
  vendorProfile   VendorProfile?
  customerProfile CustomerProfile?
  leadsSubmitted  Lead[]           @relation("CustomerLeads")
  directLeads     Lead[]           @relation("VendorDirectLeads")
  stories         Story[]

  @@index([role])
  @@map("users")
}
