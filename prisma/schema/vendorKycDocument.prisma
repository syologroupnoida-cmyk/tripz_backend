// Verified documents belong to the VENDOR (their identity), not to a specific
// KYC submission instance. Verifications can be done in any order, at any time,
// and persist across resubmissions.
model VendorKycDocument {
  id             String          @id @default(uuid())
  vendorUserId   String
  type           KycDocumentType
  documentNumber String?
  documentUrl    String?

  // Admin verification (manual review during KYC approval).
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  verifiedByAdminId String?
  notes             String?

  // Third-party verification (automated, real-time as the vendor types).
  // `provider` = STUB until a real verifier (Surepass/IDfy/Zoop/etc) is wired in.
  thirdPartyVerified   Boolean   @default(false)
  thirdPartyProvider   String?
  thirdPartyVerifiedAt DateTime?
  thirdPartyResponse   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendorUserId], references: [userId], onDelete: Cascade)

  @@unique([vendorUserId, type])
  @@map("vendor_kyc_documents")
}
