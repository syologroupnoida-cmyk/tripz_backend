model Blog {
  id       String   @id @default(uuid())
  slug     String   @unique
  title    String
  excerpt  String   @db.Text
  category String
  readTime String
  image    String
  content  String[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("blogs")
}
