// Shared enums used across multiple models.
// Keep enums consumed by a single model inside that model's file instead.

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CLIENT
}

enum EmailOtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_2FA
  AADHAAR_VERIFICATION
}

enum KycStatus {
  PENDING // Vendor signed up but has not submitted KYC yet.
  SUBMITTED // Vendor filled the KYC form; awaiting admin review.
  APPROVED // Admin approved; vendor can take work.
  REJECTED // Admin rejected; vendor must resubmit with fixes.
}

enum AuthProvider {
  LOCAL // Email + password account
  GOOGLE // Google OAuth only (no password set)
  HYBRID // Started one way, linked the other — can log in via either
}

enum CompanyType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PVT_LTD
  PUBLIC_LTD
  OTHER
}

enum ReferralSource {
  REFERENCE
  GOOGLE
  SOCIAL_MEDIA
  ADVERTISEMENT
  OTHER
}

enum KycDocumentType {
  PAN
  GSTIN
  CIN
  AADHAR
  OTHER
}

enum LeadStatus {
  PENDING_REVIEW // Customer just submitted; awaiting admin approval.
  ACTIVE // Admin approved; live on the marketplace feed.
  EXHAUSTED // Hit maxUnlocks - no more vendors can buy.
  EXPIRED // Past travelDate / TTL window - auto-closed by a cron.
  REJECTED // Admin rejected (spam, duplicate, bad data).
  CLOSED // Customer or admin manually closed.
}

enum WalletTransactionType {
  DEBIT_LEAD_UNLOCK // Vendor spent credits to unlock a lead.
  CREDIT_TOP_UP // Future: from payment gateway (Razorpay turn).
  CREDIT_REFUND // Refund for a disputed unlock.
  CREDIT_ADMIN_ADJUSTMENT // Admin granted credits manually.
  DEBIT_ADMIN_ADJUSTMENT // Admin clawed credits back.
  CREDIT_SUBSCRIPTION_GRANT // Credits granted on subscription plan purchase.
}

enum SubscriptionStatus {
  ACTIVE // Currently valid and running.
  EXPIRED // Past expiresAt - no longer valid.
  CANCELLED // Admin or vendor cancelled before expiry.
  UPGRADED // Vendor moved to a higher plan; superseded by replacedBySubscriptionId.
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PackageStatus {
  DRAFT // Vendor still editing; not visible to admin queue or customers.
  SUBMITTED // Sent for admin review.
  APPROVED // Live on marketplace — customers can inquire.
  REJECTED // Admin rejected with a reason; vendor can edit and resubmit.
  PAUSED // Vendor self-paused (off-season) or auto-paused when sub expires.
}

enum PackageType {
  HONEYMOON
  FAMILY
  HOLIDAY
  COUPLE
  SOLO
  GROUP // Friends/group trip
  ADVENTURE
  RELIGIOUS
  BEACH
  HILL_STATION
  WILDLIFE
  CULTURAL
  CORPORATE
  OTHER
}

enum PackageRegion {
  NATIONAL
  INTERNATIONAL
}

enum PackageValidityType {
  EVERGREEN // Always available; startDate/endDate optional
  SEASONAL // Time-boxed (festival, event); startDate + endDate REQUIRED
}
