// Shared enums used across multiple models.
// Keep enums consumed by a single model inside that model's file instead.

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CLIENT
}

enum EmailOtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_2FA
  AADHAAR_VERIFICATION
}

enum KycStatus {
  PENDING // Vendor signed up but has not submitted KYC yet.
  SUBMITTED // Vendor filled the KYC form; awaiting admin review.
  APPROVED // Admin approved; vendor can take work.
  REJECTED // Admin rejected; vendor must resubmit with fixes.
}

enum AuthProvider {
  LOCAL // Email + password account
  GOOGLE // Google OAuth only (no password set)
  HYBRID // Started one way, linked the other — can log in via either
}

enum CompanyType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PVT_LTD
  PUBLIC_LTD
  OTHER
}

enum ReferralSource {
  REFERENCE
  GOOGLE
  SOCIAL_MEDIA
  ADVERTISEMENT
  OTHER
}

enum KycDocumentType {
  PAN
  GSTIN
  CIN
  AADHAR
  OTHER
}

enum LeadStatus {
  PENDING_REVIEW // Customer just submitted; awaiting admin approval.
  ACTIVE // Admin approved; live on the marketplace feed.
  EXHAUSTED // Hit maxUnlocks - no more vendors can buy.
  EXPIRED // Past travelDate / TTL window - auto-closed by a cron.
  REJECTED // Admin rejected (spam, duplicate, bad data).
  CLOSED // Customer or admin manually closed.
}

enum WalletTransactionType {
  DEBIT_LEAD_UNLOCK // Vendor spent credits to unlock a lead.
  CREDIT_TOP_UP // Future: from payment gateway (Razorpay turn).
  CREDIT_REFUND // Refund for a disputed unlock.
  CREDIT_ADMIN_ADJUSTMENT // Admin granted credits manually.
  DEBIT_ADMIN_ADJUSTMENT // Admin clawed credits back.
  CREDIT_SUBSCRIPTION_GRANT // Credits granted on subscription plan purchase.
}

enum SubscriptionStatus {
  ACTIVE // Currently valid and running.
  EXPIRED // Past expiresAt - no longer valid.
  CANCELLED // Admin or vendor cancelled before expiry.
  UPGRADED // Vendor moved to a higher plan; superseded by replacedBySubscriptionId.
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PackageStatus {
  DRAFT // Vendor still editing; not visible to admin queue or customers.
  SUBMITTED // Sent for admin review.
  APPROVED // Live on marketplace — customers can inquire.
  REJECTED // Admin rejected with a reason; vendor can edit and resubmit.
  PAUSED // Vendor self-paused (off-season) or auto-paused when sub expires.
}

enum PackageType {
  HONEYMOON
  FAMILY
  HOLIDAY
  COUPLE
  SOLO
  GROUP // Friends/group trip
  ADVENTURE
  RELIGIOUS
  BEACH
  HILL_STATION
  WILDLIFE
  CULTURAL
  CORPORATE
  NATURE
  WATERACTIVITY
  OTHER
}

enum PackageRegion {
  NATIONAL
  INTERNATIONAL
}

enum PackageValidityType {
  EVERGREEN // Always available; startDate/endDate optional
  SEASONAL // Time-boxed (festival, event); startDate + endDate REQUIRED
}

enum StoryType {
  FOUNDER_STORY // Company origin / founder's journey
  CUSTOMER_STORY // Client's travel experience
  VENDOR_STORY // Vendor's business journey
  JOURNEY // General travel journey / trip story
  INSPIRATION // Motivational / inspirational content
  SUCCESS_STORY // Achievements / milestones
}

enum StoryStatus {
  PUBLISHED // Live on public site (default on create)
  HIDDEN // Admin hid it — invisible on public list but preserved for audit
}

// Business type for a VENDOR user. Base `UserRole` stays small (SUPER_ADMIN,
// ADMIN, VENDOR, CLIENT) — this enum grows over time as we add new vendor
// business categories (property host, restaurant partner, etc.).
enum VendorType {
  TRAVEL_AGENT // Travel agency — sells packages, itineraries, transfers
  PROPERTY_OWNER // Homestays / villas / rentals — hospitality business
  // Future values as new modules ship:
  // RESTAURANT_PARTNER
  // ACTIVITY_PROVIDER
  // TRANSPORT_PROVIDER
}

// Category of property being listed. Drives frontend form (Hotel shows
// multi-room UI, Villa shows single-unit UI) but backend schema is uniform.
enum PropertyType {
  HOTEL // Multiple room types with quantities (Standard/Deluxe/Suite)
  VILLA // Single self-contained unit (whole villa)
  HOMESTAY // Single unit OR multi-room family stay
  STUDIO // Single small unit (apartment-style)
  RESORT // Multi-category like hotel + resort amenities
  GUEST_HOUSE // Budget multi-room accommodation
}

// Property lifecycle — mirrors PackageStatus pattern.
enum PropertyStatus {
  DRAFT // Owner still editing, not visible to admin queue or marketplace
  SUBMITTED // Sent for admin review
  APPROVED // Live on marketplace — guests can book
  REJECTED // Admin rejected with reason; owner can edit and resubmit
  PAUSED // Owner self-paused (maintenance/off-season)
}

// Booking lifecycle — from creation through checkout to payout.
enum BookingStatus {
  CONFIRMED // Booking successful, inventory blocked
  CHECKED_IN // Owner marked guest checked in
  CHECKED_OUT // Owner marked guest checked out
  COMPLETED // Post-checkout, ready for payout
  CANCELLED // Guest or owner cancelled
  NO_SHOW // Guest didn't arrive
}

// Payment tracking on a booking. All start PENDING; payment integration
// (Razorpay) later flips to PAID / REFUNDED / FAILED.
enum PaymentStatus {
  PENDING // No payment collected yet (MVP default)
  PAID // Guest paid via gateway
  REFUNDED // Full refund issued (cancellation)
  PARTIALLY_REFUNDED // Partial refund per cancellation policy
  FAILED // Gateway failure
}

// Manual payout to property owner (admin negotiates commission offline).
enum PayoutStatus {
  PENDING // Booking completed, admin hasn't paid owner yet
  PAID // Admin manually transferred to owner (with reference)
  ON_HOLD // Dispute or issue — payout blocked temporarily
}
