model VendorKyc {
  vendorUserId         String   @id

  // ---- Company identity ----
  companyName          String
  businessName         String?
  companyType          CompanyType?
  companySinceYears    Int?
  teamSize             Int?
  companyLogoUrl       String?

  // ---- Location ----
  country              String
  officeAddress        String
  officeCity           String?
  officeState          String?

  // ---- Business operations ----
  services             String[]
  destinations         String[]
  dailyLeadRequirement Int?

  // ---- Online presence ----
  websiteUrl           String?
  facebookUrl          String?
  instagramUrl         String?

  // ---- Referral ----
  referralSource       ReferralSource?
  otherSource          String?
  marketplaceWorked    Boolean         @default(false)

  // ---- Legal declaration ----
  agreedTerms          Boolean         @default(false)
  declaredTrue         Boolean         @default(false)

  // ---- Admin workflow ----
  submittedAt          DateTime  @default(now())
  reviewedAt           DateTime?
  reviewedByAdminId    String?
  rejectionReason      String?

  vendor VendorProfile @relation(fields: [vendorUserId], references: [userId], onDelete: Cascade)

  @@map("vendor_kyc")
}
