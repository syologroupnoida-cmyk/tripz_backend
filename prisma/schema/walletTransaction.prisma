// Append-only ledger. Every change to a wallet's balance writes exactly one
// row here. `amount` is always positive; the sign is implied by `type`.
// `balanceAfter` is a snapshot for audit / reconciliation queries.
model WalletTransaction {
  id            String                @id @default(uuid())
  vendorUserId  String
  type          WalletTransactionType
  amount        Int // always >= 0
  balanceAfter  Int // snapshot post-application
  referenceType String? // "LEAD_ASSIGNMENT" / "PAYMENT" / "ADMIN"
  referenceId   String?
  notes         String?
  createdAt     DateTime              @default(now())

  wallet         Wallet          @relation(fields: [vendorUserId], references: [vendorUserId], onDelete: Cascade)
  leadAssignment LeadAssignment?

  @@index([vendorUserId, createdAt])
  @@index([type])
  @@map("wallet_transactions")
}
