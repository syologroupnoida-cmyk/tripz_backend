model Property {
  id          String @id @default(uuid())
  ownerUserId String // JWT se aayega — property owner (VendorProfile.userId)
  slug        String @unique // SEO URL: /properties/kashmir-riverside-villa

  // ---- Basic info (marketplace card + detail) ----
  // Nullable at DB level for draft flow — completeness check at submit-time
  // enforces required fields via getMissingFieldsForSubmit() in the service.
  title            String
  propertyType     PropertyType
  shortDescription String?      @db.Text
  fullDescription  String?      @db.Text

  // ---- Location ----
  city      String?
  state     String?
  country   String  @default("India")
  address   String? @db.Text
  landmark  String?
  pincode   String?
  latitude  Float?
  longitude Float?

  // ---- Media ----
  mainImage     String?
  galleryImages String[] // Min 3 recommended for marketplace credibility

  // ---- Facilities (marketplace filters + display) ----
  amenities    String[] // ["WiFi", "AC", "Pool", "Parking", "Kitchen", "Gym"]
  houseRules   String[] // ["No smoking", "No pets", "No parties"]
  nearbyPlaces String[] // ["Dal Lake - 500m", "Airport - 10km"]
  highlights   String[] // ["Mountain view", "Private balcony", "24hr checkin"]

  // ---- Property-level metadata ----
  starRating      Int? // 1-5 for HOTEL/RESORT (nullable for others)
  totalBedrooms   Int? // Aggregate across the property (for filters)
  totalBathrooms  Int?
  hostLivesOnsite Boolean @default(false) // Mainly for HOMESTAY

  // ---- Check-in / check-out ----
  checkInTime   String @default("14:00") // 24hr format "HH:mm"
  checkOutTime  String @default("11:00")
  minStayNights Int    @default(1)

  // ---- Contact (shown to guest after booking, not before) ----
  contactPhone String?
  contactEmail String?

  // ---- Cancellation policy (JSON for flexibility) ----
  // Example: { "type": "flexible", "fullRefundHours": 48, "partialRefundHours": 168 }
  cancellationPolicy Json?

  // ---- Lifecycle ----
  status            PropertyStatus @default(DRAFT)
  hasPendingReview  Boolean        @default(false) // Post-approval edit flag
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  reviewedByAdminId String?

  // ---- Soft delete + timestamps ----
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  owner    VendorProfile     @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)
  rooms    PropertyRoom[]
  bookings PropertyBooking[]

  // Indexes for common queries
  @@index([ownerUserId])
  @@index([status])
  @@index([propertyType])
  @@index([city])
  @@index([deletedAt])
  @@index([slug])
  @@map("properties")
}

// A bookable unit within a property.
//   VILLA/STUDIO/HOMESTAY = usually 1 PropertyRoom entry (totalUnits=1)
//   HOTEL/RESORT/GUEST_HOUSE = multiple entries (AC, Non-AC, Deluxe, Suite)
model PropertyRoom {
  id         String @id @default(uuid())
  propertyId String

  // ---- Identity ----
  name        String // "AC Room" / "Deluxe Suite" / "Whole Villa"
  description String? @db.Text
  category    String? // "AC" / "NON_AC" / "STANDARD" / "DELUXE" / "SUITE"

  // ---- Pricing (in paise = INR × 100) ----
  pricePerNightInPaise Int
  extraGuestFeeInPaise Int? // Optional charge per additional guest

  // ---- Capacity ----
  maxGuests  Int @default(2)
  totalUnits Int @default(1) // Villa=1, Hotel might have 20

  // ---- Physical details ----
  bedrooms     Int?
  bathrooms    Int?
  bedType      String? // "King" / "Queen" / "Twin" / "Sofa"
  roomSizeSqft Int?

  // ---- Media + facilities ----
  amenities String[] // Room-specific ["AC", "TV", "Balcony", "Attached bath"]
  images    String[]

  // ---- Availability control (owner can disable a room without deleting) ----
  isActive Boolean @default(true)

  // ---- Timestamps ----
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingItems PropertyBookingItem[]

  @@index([propertyId])
  @@index([isActive])
  @@map("property_rooms")
}

// Booking record — created when guest confirms a stay.
// A single booking can span MULTIPLE room types (line items) — e.g. a family
// booking 1 AC + 2 Non-AC in one hotel. Per-room details live in
// PropertyBookingItem below.
//
// For now (no payment gateway), status jumps directly to CONFIRMED.
// When Razorpay ships, add PENDING_PAYMENT step before CONFIRMED.
model PropertyBooking {
  id          String @id @default(uuid())
  guestUserId String // Booking guest (CLIENT role)
  propertyId  String

  // ---- Guest info (snapshot at booking time) ----
  guestName  String
  guestPhone String
  guestEmail String
  numGuests  Int    @default(1)

  // ---- Dates (whole booking shares one date window) ----
  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  nights   Int // Auto-calculated at creation

  // ---- Amount (aggregate across all items) ----
  totalAmountInPaise Int // SUM(item.subtotalInPaise)

  // ---- Status ----
  status        BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)

  // ---- Timestamps for state transitions ----
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?   @db.Text

  // ---- Payout (admin fills after negotiating commission offline) ----
  commissionInPaise   Int?
  payoutAmountInPaise Int?
  payoutStatus        PayoutStatus @default(PENDING)
  payoutReference     String? // Bank txn ref (IMPS/NEFT)
  payoutAt            DateTime?
  payoutNotes         String?      @db.Text

  // ---- Notes ----
  specialRequests String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items    PropertyBookingItem[]

  // Indexes — booking-level lookups
  @@index([guestUserId])
  @@index([propertyId])
  @@index([status])
  @@index([payoutStatus])
  @@index([checkIn, checkOut, status])
  @@map("property_bookings")
}

// Per-room line item of a booking. One booking → N items (one row per room
// type). Availability queries aggregate SUM(unitsBooked) across items for a
// given roomId over an overlapping date window.
model PropertyBookingItem {
  id        String @id @default(uuid())
  bookingId String
  roomId    String

  unitsBooked          Int
  pricePerNightInPaise Int // Snapshot at booking time
  subtotalInPaise      Int // pricePerNight × booking.nights × unitsBooked

  createdAt DateTime @default(now())

  booking PropertyBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    PropertyRoom    @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([bookingId, roomId]) // Same room shouldn't appear twice in one booking
  // Availability query hits (roomId → overlapping bookings → items)
  @@index([roomId, bookingId])
  @@index([bookingId])
  @@map("property_booking_items")
}
