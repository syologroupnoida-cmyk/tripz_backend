model VendorProfile {
  userId     String     @id
  vendorType VendorType @default(TRAVEL_AGENT)
  kycStatus  KycStatus  @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc             VendorKyc?
  documents       VendorKycDocument[]
  wallet          Wallet?
  leadAssignments LeadAssignment[]
  subscriptions   VendorSubscription[]
  packages        Package[]
  travelGuides    TravelGuide[]
  properties      Property[]

  @@index([kycStatus])
  @@index([vendorType])
  @@map("vendor_profiles")
}
