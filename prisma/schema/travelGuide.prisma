model TravelGuide {
  id               String   @id @default(uuid())
  vendorUserId     String // JWT se aayega, client se nahi
  slug             String @unique //SEO URL: /travel-guides/kashmir-adventure

  // ------Content--------
  title            String
  destination      String
  country          String
  continent        String
  category         String
  shortDescription String
  description      String   @db.Text 
  bestTimeToVisit  String
  duration         String
  budget           Float    
  currency         String
  rating           Float    
  weather          String
  language         String
  visaRequired     Boolean  
  transportation   String
  accommodation    String
  cuisine          String
  safetyRating     Float

  // -------Media------
  mainImage        String
  galleryImages    String[] 
  
  // -------Structured lists (Postgress test[])---------
  highlights       String[]
  activities       String[]
  tips             String[]

  // -------Soft delete + timestamps--------
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt


  // Relation to vendor -  Cascade means vednor delete hoga toh guides bhi delete 
  vendor VendorProfile @relation(fields: [vendorUserId], references: [userId], onDelete: Cascade)

  // Indexes = jinme filter/search common hoga
  @@index([vendorUserId])
  @@index([country])
  @@index([continent])
  @@index([category])
  @@index([deletedAt])
  @@map("travel_guides")
}