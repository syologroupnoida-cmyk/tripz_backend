// A travel inquiry submitted by a customer. Two-layer storage:
//   - Hot/indexed columns up top (destination, contact, status, pricing, dates).
//   - Everything else from the wizard goes into `requirements` (JSONB) so we
//     can evolve the form without migrations.
model Lead {
  id String @id @default(uuid())

  // ---- Indexed top-level fields ----
  destination    String // form.destination
  departureCity  String?   // form.departureCity — promoted from JSONB; vendors filter by hub
  travelDate     DateTime? // form.travelDate — promoted from JSONB; date-range + expiry cron
  email          String // form.email (masked in teaser mode)
  phone          String // form.phone (masked in teaser mode)
  budget         Int? // form.budget; "" -> null, else INR amount
  customerUserId String? // null for anonymous/public submissions

  // ---- Dynamic requirements (JSONB) ----
  // Bundles non-hot wizard fields: duration, ticketsBooked, hotelCategory,
  // flightRequired, adults, infants, children, bookingTimeline, cabRequired,
  // packageType, preferredCallTime, otherDestinations, tourType, whatsappUpdates.
  // departureCity + travelDate now live as top-level columns (above).
  requirements Json

  // ---- Marketplace mechanics ----
  status         LeadStatus @default(PENDING_REVIEW)
  priceInCredits Int        @default(10) // cost a vendor pays to unlock
  maxUnlocks     Int        @default(3) // cap on vendors who can buy
  unlockCount    Int        @default(0) // monotonically increasing counter

  // ---- Admin workflow ----
  reviewedAt        DateTime?
  reviewedByAdminId String?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    User?            @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  assignments LeadAssignment[]

  @@index([status])
  @@index([destination])
  @@index([departureCity])
  @@index([travelDate]) // powers upcoming auto-EXPIRED cron + vendor "next 30 days" filter
  @@index([createdAt])
  @@index([email]) // fast auto-link of anonymous leads at customer registration
  @@map("leads")
}
