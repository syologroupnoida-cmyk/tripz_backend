# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripz?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string-min-32-chars"
# Used to sign short-lived (10 min) password-reset tokens. MUST differ from the
# two secrets above so a leaked reset token can never be used as an access token.
JWT_RESET_SECRET="replace-with-yet-another-long-random-string-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Security ---
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
CORS_ORIGIN="http://localhost:3000"

# --- Email / SMTP ---
# Dev: Mailtrap (https://mailtrap.io) — free inbox, no real emails sent.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER="replace-with-mailtrap-user"
SMTP_PASS="replace-with-mailtrap-pass"
MAIL_FROM_NAME="Tripz"
MAIL_FROM_ADDRESS="no-reply@tripz.local"

# Prod: Resend (smtp.resend.com / port 465 / SMTP_SECURE=true / SMTP_USER=resend / SMTP_PASS=<api-key>)
#       or Postmark / AWS SES — only env vars change, no code change.
# ✅ NEW PRODUCTION (Resend Real Delivery)
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="resend"
# SMTP_PASS="re_abc123XyZ_YourActualResendApiKeyHere"
# MAIL_FROM_ADDRESS="onboarding@yourdomain.com"  # Your verified business domain

# --- OTP policy ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Google OAuth ---
# Get this from https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Only the public Client ID is needed — no client secret (we verify ID tokens, not server-side code exchange).
GOOGLE_CLIENT_ID="123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# --- Cloudinary (image / document hosting) ---
# Sign up free at https://cloudinary.com — find these in Dashboard → "API Environment variable".
# Keep API_SECRET private (never expose to frontend).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"
# Optional: override the upload size limit (default 5 MB)
# UPLOAD_MAX_BYTES=5242880

# --- Surepass (KYC verification: PAN / GSTIN / CIN / Aadhaar) ---
# Sign up at https://surepass.io → Dashboard → "API Token".
# Leave SUREPASS_TOKEN empty/unset to keep STUB mode (mock responses, OTPs printed
# to server console — safe for development without a Surepass account).
# Sandbox token returns mock data for predefined test numbers.
# Live token hits real government APIs (charges per call after free credits).
# SUREPASS_TOKEN="paste-your-surepass-token-here"
# Optional overrides — defaults are fine for both sandbox and live.
# SUREPASS_BASE_URL="https://kyc-api.surepass.io/api/v1"
# SUREPASS_TIMEOUT_MS=15000

# DigiLocker callback URL — where Surepass sends the user back after they
# finish Aadhaar verification on DigiLocker. Must be HTTPS (Surepass rejects
# http://). In production set this to your real frontend route, e.g.:
#   SUREPASS_REDIRECT_URL="https://trip-z.in/kyc/aadhaar-callback"
# Leave unset to use the Surepass console default (only works for dashboard
# testing — real users will see a Surepass branded page on redirect).

# Surepass endpoint used by /aadhaar/complete to fetch verified Aadhaar data.
# The exact path varies by Surepass account — find yours in the dashboard.
# Common values to try:
#   /digilocker/get-aadhaar     (default, may be wrong for some accounts)
#   /digilocker/aadhaar
#   /digilocker/fetch-aadhaar
#   /digilocker/get-documents
#   /aadhaar-v2/aadhaar
# SUREPASS_DIGILOCKER_FETCH_PATH="/digilocker/aadhaar"

# --- SuperAdmin seed (used by `npm run prisma:seed`) ---
# The seed script is idempotent — re-running won't duplicate the account.
SUPERADMIN_EMAIL="superadmin@tripz.local"
SUPERADMIN_PASSWORD="ChangeMe!23"
SUPERADMIN_FIRST_NAME="Super"
SUPERADMIN_LAST_NAME="Admin"
SUPERADMIN_PHONE="9999999999"
